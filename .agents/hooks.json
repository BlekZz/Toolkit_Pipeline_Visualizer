{
  "claude-guards-pilot": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          { "type": "command", "command": "node %USERPROFILE%/.claude/scripts/rg-replace-guard.mjs", "timeout": 20 }
        ]
      },
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          { "type": "command", "command": "node %USERPROFILE%/.claude/scripts/coldbench-guard.mjs", "timeout": 20 }
        ]
      }
    ]
  }
}
